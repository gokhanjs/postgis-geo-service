PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=geo_service

# Integration test suite. Created automatically by the Docker init scripts.
TEST_DB_NAME=geo_service_test

# --- Optional: road routing -------------------------------------------------
# Left unset, /routing endpoints answer 503 and everything else works normally.
# Bring the service up with:  docker compose --profile routing up -d
# OSRM_URL=http://127.0.0.1:5000
# OSRM_PORT=5000

# Which OSM extract to preprocess. Monaco is tiny (~600 KB) and processes in
# seconds, which is why it is the default. Swap in any Geofabrik extract; be
# aware that a country-sized file needs several GB of RAM to process.
# OSRM_REGION_NAME=monaco
# OSRM_REGION_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf

# --- Optional: network restrictions -----------------------------------------
# When set, only these client IPs are accepted. Unset means open to all.
# ALLOWED_IPS=127.0.0.1,::1

# Number of reverse proxies in front of this service. Only set this when the
# proxy overwrites X-Forwarded-For rather than appending to it, otherwise a
# client can spoof its own address past ALLOWED_IPS and the rate limiter.
# TRUST_PROXY_HOPS=1
