PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=geo_service

# IP Kısıtlaması (opsiyonel)
# Tanımlıysa yalnızca bu IP'lerden gelen istekler kabul edilir.
# Tanımlı değilse herkese açık çalışır.
# Örnek — sadece aynı sunucu: ALLOWED_IPS=127.0.0.1,::1
# Örnek — belirli sunucular:  ALLOWED_IPS=127.0.0.1,::1,10.0.0.5,10.0.0.6
# ALLOWED_IPS=

# Reverse proxy (nginx, Caddy vb.) arkasında çalışıyorsa true yap.
# true olunca istemci IP'si X-Forwarded-For başlığından okunur.
# TRUST_PROXY=false
