{
  "name": "postgis-geo-service",
  "version": "2.0.0",
  "description": "Multi-tenant geospatial microservice for proximity search, geofencing and road routing",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node scripts/migrate.ts up",
    "migrate:down": "node scripts/migrate.ts down",
    "keys": "node scripts/keys.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
