# Copy to .env next to compose.yml and keep it mode 600. Every value here is an example.
# Generate passwords with:  openssl rand -hex 32

# --- Required ----------------------------------------------------------------
# Database image tag. Changed deliberately, after a backup; deploy.sh never does.
DB_VERSION=1.1.0

# The service's restricted role. Set before the first deploy: the migration that
# creates the role reads it once.
DB_PASS=change-me

# The database owner, used by migrations, backups and token rotation.
MIGRATION_DB_PASS=change-me

# --- Database ------------------------------------------------------------------
# DB_NAME=geo_service
# MIGRATION_DB_USER=postgres

# --- Network -------------------------------------------------------------------
# Loopback port the reverse proxy forwards to. Nothing else is published.
API_PORT=3100

# Client addresses accepted. Include 127.0.0.1: health checks run inside the container.
ALLOWED_IPS=127.0.0.1,203.0.113.10

# One proxy in front, and it must overwrite X-Forwarded-For (see nginx/).
TRUST_PROXY_HOPS=1

# CORS_ORIGINS=https://app.example.com

# --- Routing -------------------------------------------------------------------
# Unset answers 503 on /routing; everything else works.
# OSRM_URL=http://osrm:5000

# --- Limits --------------------------------------------------------------------
# RATE_LIMIT_MAX=100
# RATE_LIMIT_IP_MAX=1000
# RATE_LIMIT_WINDOW_MS=60000
# BODY_LIMIT_BYTES=262144

# --- Monitoring ----------------------------------------------------------------
# Ping URLs of a healthchecks.io-compatible service. Unset skips the ping.
HC_WATCH_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
HC_BACKUP_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Days of nightly dumps kept in backups/.
# BACKUP_KEEP_DAYS=7
